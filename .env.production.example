NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://bus.example.edu
PUBLIC_API_URL=https://bus.example.edu
WEB_PORT=8080

POSTGRES_DB=university_bus
POSTGRES_USER=bus_app
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql://bus_app:CHANGE_THIS_DATABASE_PASSWORD@postgres:5432/university_bus?schema=public

JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_RANDOM_ACCESS_SECRET_OF_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_REFRESH_SECRET_32_CHARS
QR_SIGNING_SECRET=CHANGE_THIS_TO_A_DIFFERENT_QR_SECRET_OF_32_CHARS
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BOOKING_HOLD_MINUTES=15

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:transport@example.edu
UPLOAD_DIR=/app/uploads
LOG_LEVEL=info

SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
SEED_DRIVER_PASSWORD=CHANGE_THIS_DRIVER_PASSWORD
SEED_STUDENT_PASSWORD=CHANGE_THIS_STUDENT_PASSWORD
